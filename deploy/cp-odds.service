[Unit]
Description=HKJC2 — scrape live odds + trigger audit at T-15
OnFailure=cp-failure-notify@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hkjc2
Environment=PATH=/opt/hkjc2/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c '/opt/hkjc2/.venv/bin/python scripts/ingest_odds.py --date $$(date +%%Y-%%m-%%d) --audit'
