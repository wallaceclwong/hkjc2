[Unit]
Description=HKJC2 — scrape live odds + refresh predictions + trigger audit at T-15
After=network.target
OnFailure=cp-failure-notify@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hkjc2
Environment=PATH=/opt/hkjc2/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash -c '/opt/hkjc2/.venv/bin/python3 scripts/ingest_odds.py --date $$(date +%%Y-%%m-%%d) --audit'
