[Unit]
Description=HKJC2 — generate predictions after racecards
After=cp-racecards.service

[Service]
Type=oneshot
User=cp
WorkingDirectory=/opt/hkjc2
Environment="PATH=/opt/hkjc2/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/hkjc2/.venv/bin/python scripts/predict.py --date $(date +%%Y-%%m-%%d) --venue ST
