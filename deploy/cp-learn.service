[Unit]
Description=HKJC2 — scrape results and settle bets nightly
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/hkjc2
Environment="PATH=/opt/hkjc2/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/hkjc2/.venv/bin/python scripts/learn.py --date $(date +%%Y-%%m-%%d) --venue ST
