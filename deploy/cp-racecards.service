[Unit]
Description=HKJC2 — scrape racecards for today
After=network.target

[Service]
Type=oneshot
User=cp
WorkingDirectory=/opt/hkjc2
Environment="PATH=/opt/hkjc2/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/opt/hkjc2/.venv/bin/python scripts/ingest_racecards.py --date $(date +%%Y-%%m-%%d) --venue ST
